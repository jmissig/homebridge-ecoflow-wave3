{
  "pluginAlias": "EcoFlowWave3",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "required": ["name", "email", "password", "apiHost", "devices"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "EcoFlow WAVE 3",
        "minLength": 2,
        "maxLength": 64,
        "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}\\p{Zs}’'&!._:;()/,-]*[\\p{L}\\p{N}]$"
      },
      "email": {
        "title": "EcoFlow Account Email",
        "type": "string",
        "format": "email",
        "maxLength": 320
      },
      "password": {
        "title": "EcoFlow Account Password",
        "type": "string",
        "format": "password",
        "minLength": 1
      },
      "apiHost": {
        "title": "EcoFlow API Region",
        "type": "string",
        "default": "api.ecoflow.com",
        "oneOf": [
          { "title": "Global", "enum": ["api.ecoflow.com"] },
          { "title": "Americas", "enum": ["api-a.ecoflow.com"] },
          { "title": "Europe", "enum": ["api-e.ecoflow.com"] }
        ]
      },
      "advancedApiHostOverride": {
        "title": "Advanced: Unreviewed API Host Override",
        "description": "Danger: account credentials will be sent to this host. Leave blank unless you have independently verified it.",
        "type": "string",
        "maxLength": 253,
        "anyOf": [
          { "maxLength": 0 },
          {
            "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        ]
      },
      "devices": {
        "title": "WAVE 3 Units",
        "description": "Each WAVE 3 serial number must be unique; cross-item serial uniqueness is enforced at runtime.",
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "required": ["name", "serialNumber"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Display Name",
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N}\\p{Zs}’'&!._:;()/,-]*[\\p{L}\\p{N}]$"
            },
            "serialNumber": {
              "title": "WAVE 3 Serial Number",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{4,64}$"
            },
            "currentTemperatureSource": {
              "title": "Current Temperature Source",
              "description": "Ambient also reports ambient humidity. Outlet uses the provisional indoor supply-air field. None experimentally removes HomeKit's normally required current-temperature characteristic.",
              "type": "string",
              "default": "ambient",
              "oneOf": [
                { "title": "Ambient Temperature", "enum": ["ambient"] },
                { "title": "Outlet / Supply-Air Temperature (Experimental)", "enum": ["outlet"] },
                { "title": "No Current Temperature (Experimental)", "enum": ["none"] }
              ]
            }
          }
        }
      }
    }
  }
}
